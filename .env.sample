# Required. Cadenya API key with the objectives:manage scope.
CADENYA_API_KEY=YOUR_CADENYA_API_KEY

# Required. The workspace that owns the agent (the ID after /w/ in the dashboard URL).
CADENYA_WORKSPACE_ID=YOUR_CADENYA_WORKSPACE_ID

# Required. The agent that answers in Slack: an agent ID or external_id:<value>.
CADENYA_AGENT_ID=external_id:slack-agent

# Required. The account webhook signing key (whsec_...), from Account Admin > Webhooks.
CADENYA_WEBHOOK_SECRET=YOUR_CADENYA_WEBHOOK_SECRET

# Optional. Port for the Cadenya webhook receiver. Defaults to 3210.
# PORT=3210

# Optional, uncomment and set when running without the Slack CLI (npm start).
# SLACK_APP_TOKEN=YOUR_SLACK_APP_TOKEN
# SLACK_BOT_TOKEN=YOUR_SLACK_BOT_TOKEN

# Optional, uncomment and set when using a custom Slack instance.
# SLACK_API_URL=YOUR_SLACK_API_URL
